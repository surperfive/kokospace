{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kokospace",
  // Account ID 不是密钥（Dashboard 的地址栏里就有），写在这里本地部署就不用再设
  // CLOUDFLARE_ACCOUNT_ID 环境变量。换账号时改这一行即可。
  "account_id": "ce72297a5f7faac96aeb087d4ad1b77e",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // 前端构建产物：由 Workers 静态资源直接托管，不需要另外开 Pages
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // 每个房间一个 Durable Object，负责该房间的 WebSocket 与状态
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    }
  ],

  "observability": {
    "enabled": true
  }
}
