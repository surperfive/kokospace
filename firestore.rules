rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidAvatarMap(av) {
      return av is map
        && av.keys().hasAll(['skinColor', 'hairStyle', 'hairColor', 'eyeStyle', 'outfitStyle', 'outfitColor', 'accessory'])
        && av.keys().hasOnly(['skinColor', 'hairStyle', 'hairColor', 'eyeStyle', 'outfitStyle', 'outfitColor', 'accessory'])
        && av.skinColor is string && av.skinColor.size() >= 4 && av.skinColor.size() <= 16
        && av.hairStyle is string && av.hairStyle.size() >= 1 && av.hairStyle.size() <= 32
        && av.hairColor is string && av.hairColor.size() >= 4 && av.hairColor.size() <= 16
        && av.eyeStyle is string && av.eyeStyle.size() >= 1 && av.eyeStyle.size() <= 32
        && av.outfitStyle is string && av.outfitStyle.size() >= 1 && av.outfitStyle.size() <= 32
        && av.outfitColor is string && av.outfitColor.size() >= 4 && av.outfitColor.size() <= 16
        && av.accessory is string && av.accessory.size() >= 1 && av.accessory.size() <= 32;
    }

    function isValidProfile(data, userId) {
      return data.keys().hasAll(['ownerUid', 'displayName', 'preferredMapId', 'avatar', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'displayName', 'preferredMapId', 'avatar', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && data.ownerUid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 32
        && data.preferredMapId in ['sunset-rooftop', 'gallery-theater', 'forest-cabin']
        && isValidAvatarMap(data.avatar)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScene(data, sceneId) {
      return data.keys().hasAll(['sceneId', 'ownerUid', 'roomName', 'mapId', 'furniture', 'defaultVideoUrl', 'isPublic', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['sceneId', 'ownerUid', 'roomName', 'mapId', 'furniture', 'defaultVideoUrl', 'isPublic', 'createdAt', 'updatedAt'])
        && isValidId(data.sceneId)
        && data.sceneId == sceneId
        && isValidId(data.ownerUid)
        && data.ownerUid == request.auth.uid
        && data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 48
        && data.mapId in ['sunset-rooftop', 'gallery-theater', 'forest-cabin']
        && data.furniture is list && data.furniture.size() <= 40
        && (data.furniture.size() == 0 || data.furniture[0] is map)
        && data.defaultVideoUrl is string && data.defaultVideoUrl.size() <= 512
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 3. Profiles Collection (/profiles/{userId}) - Strictly Owner-Only
    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && existing().ownerUid == request.auth.uid
        && isValidProfile(incoming(), userId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredMapId', 'avatar', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(userId) && existing().ownerUid == request.auth.uid;
    }

    // 4. Scenes Collection (/scenes/{sceneId}) - Owner Write, Owner/Public Read
    match /scenes/{sceneId} {
      allow get: if isValidId(sceneId) && (existing().isPublic == true || (isSignedIn() && existing().ownerUid == request.auth.uid));
      allow list: if isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(sceneId)
        && isValidScene(incoming(), sceneId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(sceneId)
        && existing().ownerUid == request.auth.uid
        && isValidScene(incoming(), sceneId)
        && incoming().sceneId == existing().sceneId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['roomName', 'mapId', 'furniture', 'defaultVideoUrl', 'isPublic', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(sceneId) && existing().ownerUid == request.auth.uid;
    }
  }
}
